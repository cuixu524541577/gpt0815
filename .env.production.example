# ============================================================
# 生产部署环境变量模板
# 用法：cp .env.production.example .env && 填写后 docker compose up -d
# 注意：.env 不要提交到 git（真实凭据）
# ============================================================

# ---- 管理员凭据（首次启动自动创建；之后修改凭据用配置页/重置）----
# 必须是强密码！服务器在海外公网，弱密码等于裸奔
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成至少16位强密码

# ---- Telegram 通知（可选，留空则不发通知）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 时区 ----
TZ=Asia/Shanghai

# ============================================================
# 代理配置（中国大陆 IP 无法直连 OpenAI，必须配置海外代理）
# 以下变量会覆盖 config/proxy.py 的同名配置（见 config/env_loader.py）
# 填入你的代理池（每行一个；网关型代理如辣椒：http://user:pass@host:port）
# ============================================================
# PROXY_POOL=http://账号-参数:密码@us.lajiaohttp.net:2000
# 或动态住宅代理池（厂商提取 API，需把服务器公网 IP 加白名单）：
# PROXY_DYNAMIC_ENABLED=true
# PROXY_DYNAMIC_MODE=api
# PROXY_DYNAMIC_API_URL=http://api.lajiaohttp.com/api/extract_ip?regions=us&num=20&protocol=http&type=txt&cate=1&t=10

# ============================================================
# 其他常用覆盖（完整清单见 .env.example）
# ============================================================
# 接码平台（SMS_PROVIDER 等）按需填写
# SMS_API_KEY=
